{
  "info": {
    "_postman_id": "63923b95-cfc0-49b8-b4bd-884b3f33ce33",
    "name": "Virtual Event Management API",
    "description": "Main success flows. Run register/login requests, then use the automatically captured tokens and event ID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "organizerToken", "value": "" },
    { "key": "attendeeToken", "value": "" },
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Register organizer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Organizer\",\n  \"email\": \"organizer@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"organizer\"\n}" },
        "url": "{{baseUrl}}/register"
      }
    },
    {
      "name": "Login organizer",
      "event": [{
        "listen": "test",
        "script": { "exec": ["const body = pm.response.json();", "if (body.success) pm.collectionVariables.set('organizerToken', body.data.token);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"organizer@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "Create event",
      "event": [{
        "listen": "test",
        "script": { "exec": ["const body = pm.response.json();", "if (body.success) pm.collectionVariables.set('eventId', body.data.event.id);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Virtual Node.js Summit\",\n  \"description\": \"A practical backend event.\",\n  \"date\": \"2099-08-20\",\n  \"time\": \"14:30\"\n}" },
        "url": "{{baseUrl}}/events"
      }
    },
    {
      "name": "Register attendee",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Attendee\",\n  \"email\": \"attendee@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"attendee\"\n}" },
        "url": "{{baseUrl}}/register"
      }
    },
    {
      "name": "Login attendee",
      "event": [{
        "listen": "test",
        "script": { "exec": ["const body = pm.response.json();", "if (body.success) pm.collectionVariables.set('attendeeToken', body.data.token);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"attendee@example.com\",\n  \"password\": \"password123\"\n}" },
        "url": "{{baseUrl}}/login"
      }
    },
    {
      "name": "List events",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }], "url": "{{baseUrl}}/events" }
    },
    {
      "name": "Register for event",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }], "url": "{{baseUrl}}/events/{{eventId}}/register" }
    },
    {
      "name": "My registrations",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{attendeeToken}}" }], "url": "{{baseUrl}}/me/registrations" }
    },
    {
      "name": "Owner participant list",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }], "url": "{{baseUrl}}/events/{{eventId}}/participants" }
    }
  ]
}
